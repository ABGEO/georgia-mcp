# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.go,go.mod,go.work}]
indent_style = tab
indent_size = 4

[*.conf]
indent_size = 4

# List items and code blocks set their own indent.
[*.md]
indent_size = unset

# The license is the verbatim text of the GPL.
[LICENSE]
indent_style = unset
indent_size = unset

# A capture of a vendor answer keeps each byte as the vendor sent it.
[**/testdata/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# The verification token of OpenAI holds no final newline.
[website/public/.well-known/openai-apps-challenge]
insert_final_newline = false
