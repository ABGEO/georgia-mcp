ption":"EURO REGULAR","type":"PETROL","octane":93.7,"country":"ბულგარეთი/რუმინეთი","standard":"ევრო 5","sulfurContent":6,"order":0,"cetaneNumber":0}},{"id":"61bff140-9c4a-481e-a061-84a040093075","name":"EURO DIESEL","type":"DIESEL","octane":0,"latestPrice":"4.94","latestOnlinePrice":"4.74","fuelType":{"id":"61bff140-9c4a-481e-a061-84a040093075","name":"EURO DIESEL","slug":"euro-diesel","description":"EURO DIESEL","type":"DIESEL","octane":0,"country":"რუმინეთი/რუსეთი","standard":"ევრო 5","sulfurContent":5,"order":0,"cetaneNumber":52.8}},{"id":"dcf413da-9e18-410f-8e0d-8f9f74dfcc5a","name":"EFFECT DIESEL","type":"DIESEL","octane":0,"latestPrice":"4.84","latestOnlinePrice":"4.64","fuelType":{"id":"dcf413da-9e18-410f-8e0d-8f9f74dfcc5a","name":"EFFECT DIESEL","slug":"effect-diesel","description":"EFFECT DIESEL","type":"DIESEL","octane":0,"country":"რუსეთი/საბერძნეთი/ბულგარეთი","standard":"ევრო 5","sulfurContent":9.5,"order":0,"cetaneNumber":52.3}}]}]}]]}]}]
