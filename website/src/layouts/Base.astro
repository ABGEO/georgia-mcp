---
import { Font } from "astro:assets"

import Band from "../components/Band.astro"
import LangSwitch from "../components/LangSwitch.astro"
import Mark from "../components/Mark.astro"
import ThemeToggle from "../components/ThemeToggle.astro"
import { localize, other, t } from "../i18n"
import type { Lang } from "../lib/schemas"
import { AUTHOR_URL, REPO_URL, SITE_NAME, SITE_URL } from "../site"
import "../styles/global.css"

interface Props {
  lang: Lang
  path: string
  title: string
  description: string
  noindex?: boolean
}

const { lang, path, title, description, noindex = false } = Astro.props
const copy = t(lang)
const canonical = new URL(localize(path, lang), SITE_URL).href
const image = new URL(`/og/${lang}.png`, SITE_URL).href
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={other(lang)} href={new URL(localize(path, other(lang)), SITE_URL).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(localize(path, "en"), SITE_URL).href} />
          <meta property="og:url" content={canonical} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf7f0" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a1614" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={copy.meta.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme")
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme
      } catch {}
    </script>
    <Font cssVariable="--font-display" preload={lang === "en"} />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-georgian" preload={lang === "ka"} />
  </head>
  <body>
    <a class="skip" href="#main">{copy.nav.skip}</a>
    <header class="top">
      <div class="wrap bar">
        <a class="lockup" href={localize("/", lang)} aria-label={copy.nav.home}>
          <Mark size={30} />
          <span>{SITE_NAME}</span>
        </a>
        <nav aria-label={SITE_NAME}>
          <a href={`${localize("/", lang)}#tools`}>{copy.nav.tools}</a>
          <a href={`${localize("/", lang)}#install`}>{copy.nav.install}</a>
          <LangSwitch lang={lang} path={path} />
          <ThemeToggle lang={lang} />
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap"><Band /></div>
      <div class="wrap row">
        <p lang="en">Made with <span role="img" aria-label="love">❤️</span> in Georgia by <a href={AUTHOR_URL}>ABGEO</a></p>
        <nav class="links" aria-label={copy.footer.label}>
          <a href={localize("/privacy/", lang)}>{copy.footer.privacy}</a>
          <a href={localize("/terms/", lang)}>{copy.footer.terms}</a>
          <a href={REPO_URL}>{copy.footer.repo}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -100px;
    padding: calc(var(--u) * 2) calc(var(--u) * 4);
    background: var(--wine);
    color: var(--paper);
    border-radius: var(--radius);
    z-index: 10;
  }

  .skip:focus {
    top: 12px;
  }

  .top {
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--u) * 4);
    padding-block: calc(var(--u) * 4);
  }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    text-decoration: none;
  }

  .lockup :global(.mark) {
    color: var(--wine);
  }

  .lockup span {
    font: 600 1.3rem / 1 var(--display);
  }

  .bar nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--u) * 2) calc(var(--u) * 5);
    font-size: 0.95rem;
  }

  .bar nav > a {
    color: var(--ink);
    text-decoration: none;
  }

  .bar nav > a:hover {
    color: var(--wine);
  }

  .foot {
    margin-top: calc(var(--u) * 8);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: calc(var(--u) * 4);
    padding-block: calc(var(--u) * 8);
    font-size: 0.92rem;
    color: var(--muted);
  }

  .row p {
    font-family: var(--body);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--u) * 2) calc(var(--u) * 5);
  }
</style>
