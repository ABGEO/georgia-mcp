---
import type { Lang } from "../lib/schemas"
import { t } from "../i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const copy = t(lang).nav
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-system={copy.themes.system}
  data-light={copy.themes.light}
  data-dark={copy.themes.dark}
>
  <span class="label">{copy.theme}</span>
  <span data-theme-name>{copy.themes.system}</span>
</button>

<script>
  const order = ["system", "light", "dark"] as const
  type Mode = (typeof order)[number]

  const read = (): Mode => {
    try {
      const value = localStorage.getItem("theme")
      return value === "light" || value === "dark" ? value : "system"
    } catch {
      return "system"
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const name = button.querySelector("[data-theme-name]")
    const show = (mode: Mode) => {
      if (name) name.textContent = button.dataset[mode] ?? mode
    }
    show(read())

    button.addEventListener("click", () => {
      const mode = order[(order.indexOf(read()) + 1) % order.length]
      try {
        if (mode === "system") localStorage.removeItem("theme")
        else localStorage.setItem("theme", mode)
      } catch {
        // The browser keeps no data. The choice lasts for this page only.
      }
      if (mode === "system") document.documentElement.removeAttribute("data-theme")
      else document.documentElement.dataset.theme = mode
      show(mode)
    })
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--u) * 2);
    padding: calc(var(--u) * 2) calc(var(--u) * 3);
    font: 500 0.85rem / 1.2 var(--body);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
  }

  :lang(ka) .theme-toggle {
    font-family: var(--geo);
  }
</style>
