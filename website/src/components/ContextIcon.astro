---
import { Bus, CalendarHeart, ChartColumn, Clapperboard, Construction, CreditCard, Fuel, Landmark, LandPlot, Mailbox, Scale, Vote, Wind, Zap } from "@lucide/astro"

interface Props {
  name: string
  size?: number
}

const icons = { landmark: Landmark, fuel: Fuel, bus: Bus, "credit-card": CreditCard, mailbox: Mailbox, clapperboard: Clapperboard, "chart-column": ChartColumn, wind: Wind, scale: Scale, "calendar-heart": CalendarHeart, "land-plot": LandPlot, construction: Construction, vote: Vote, zap: Zap }

const { name, size = 28 } = Astro.props
const Icon = icons[name as keyof typeof icons] ?? Landmark
---

<Icon size={size} stroke-width={1.5} aria-hidden="true" />
