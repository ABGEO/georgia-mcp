{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    "group:allNonMajor"
  ],
  "draftPR": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/testdata/**"
  ],
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "The pnpm image of the website Dockerfile follows packageManager in website/package.json.",
      "matchPackageNames": ["pnpm", "ghcr.io/pnpm/pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "A non-major update opens ready for review. GitHub merges it after the approval of the code owner and the checks.",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "draftPR": false,
      "automerge": true,
      "platformAutomerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The version of mcp-publisher in images.yml.",
      "managerFilePatterns": ["/^\\.github/workflows/images\\.yml$/"],
      "matchStrings": ["MCP_PUBLISHER_VERSION: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "modelcontextprotocol/registry"
    },
    {
      "customType": "regex",
      "description": "The version of GoReleaser in release.yml.",
      "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
      "matchStrings": ["GORELEASER_VERSION: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "goreleaser/goreleaser"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "pnpmDedupe"
  ]
}
