{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "pnpmDedupe"
  ]
}
