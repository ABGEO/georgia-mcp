GEOMCP_LOG_LEVEL=info
GEOMCP_LOG_FORMAT=json

GEOMCP_HTTP_ADDRESS=:8080
GEOMCP_HTTP_TRUSTED_PROXIES=
GEOMCP_HTTP_ALLOWED_ORIGINS=
GEOMCP_HTTP_RATE_LIMIT=60
GEOMCP_HTTP_RATE_WINDOW=1m

GEOMCP_RATES_NBG_BASE_URL=https://nbg.gov.ge/gw/api/ct/monetarypolicy
GEOMCP_RATES_NBG_TIMEOUT=10s
GEOMCP_RATES_NBG_RATE=5
GEOMCP_RATES_NBG_BURST=5
GEOMCP_RATES_NBG_CACHE_ENTRIES=512

# A key of a developer account at developers.tbcbank.ge. Empty turns TBC Bank off.
GEOMCP_RATES_TBC_API_KEY=
GEOMCP_RATES_TBC_BASE_URL=https://api.tbcbank.ge
GEOMCP_RATES_TBC_TIMEOUT=10s
GEOMCP_RATES_TBC_RATE=1
GEOMCP_RATES_TBC_BURST=1

# Bank of Georgia needs no key. false turns it off.
GEOMCP_RATES_BOG_ENABLED=true
GEOMCP_RATES_BOG_BASE_URL=https://api.businessonline.ge
GEOMCP_RATES_BOG_TIMEOUT=10s
GEOMCP_RATES_BOG_RATE=0.8
GEOMCP_RATES_BOG_BURST=10

# Liberty Bank needs no key. false turns it off.
GEOMCP_RATES_LIBERTY_ENABLED=true
GEOMCP_RATES_LIBERTY_BASE_URL=https://www.libertybank.ge
GEOMCP_RATES_LIBERTY_TIMEOUT=10s
GEOMCP_RATES_LIBERTY_RATE=1
GEOMCP_RATES_LIBERTY_BURST=1

# Terabank needs no key. false turns it off.
GEOMCP_RATES_TERABANK_ENABLED=true
GEOMCP_RATES_TERABANK_BASE_URL=https://terabank.ge
GEOMCP_RATES_TERABANK_TIMEOUT=10s
GEOMCP_RATES_TERABANK_RATE=1
GEOMCP_RATES_TERABANK_BURST=1

# Rico Credit needs no key. It is a microfinance organization, not a bank. false turns it off.
GEOMCP_RATES_RICO_ENABLED=true
GEOMCP_RATES_RICO_BASE_URL=https://www.rico.ge
GEOMCP_RATES_RICO_TIMEOUT=10s
GEOMCP_RATES_RICO_RATE=1
GEOMCP_RATES_RICO_BURST=1

# Kursi.ge needs no key. It is an online exchange bureau. false turns it off.
GEOMCP_RATES_KURSI_ENABLED=true
GEOMCP_RATES_KURSI_BASE_URL=https://api-core.kursi.ge
GEOMCP_RATES_KURSI_TIMEOUT=10s
GEOMCP_RATES_KURSI_RATE=1
GEOMCP_RATES_KURSI_BURST=1

# Wissol needs no key. false turns it off.
GEOMCP_FUEL_WISSOL_ENABLED=true
GEOMCP_FUEL_WISSOL_BASE_URL=https://api.wissol.ge
GEOMCP_FUEL_WISSOL_TIMEOUT=10s
GEOMCP_FUEL_WISSOL_RATE=1
GEOMCP_FUEL_WISSOL_BURST=1

# Rompetrol needs no key. false turns it off.
GEOMCP_FUEL_ROMPETROL_ENABLED=true
GEOMCP_FUEL_ROMPETROL_BASE_URL=https://www.rompetrol.ge
GEOMCP_FUEL_ROMPETROL_TIMEOUT=10s
GEOMCP_FUEL_ROMPETROL_RATE=1
GEOMCP_FUEL_ROMPETROL_BURST=1

# SOCAR needs no key. false turns it off.
GEOMCP_FUEL_SOCAR_ENABLED=true
GEOMCP_FUEL_SOCAR_BASE_URL=https://sgp.ge/sgp-backend/api
GEOMCP_FUEL_SOCAR_TIMEOUT=10s
GEOMCP_FUEL_SOCAR_RATE=1
GEOMCP_FUEL_SOCAR_BURST=1

# false turns the TTC off.
GEOMCP_TRANSIT_TTC_ENABLED=true
# The key of the TTC, which its web page publishes. Required while the TTC is on.
GEOMCP_TRANSIT_TTC_API_KEY=
GEOMCP_TRANSIT_TTC_BASE_URL=https://transit.ttc.com.ge/pis-gateway/api
GEOMCP_TRANSIT_TTC_TIMEOUT=10s
GEOMCP_TRANSIT_TTC_RATE=4
GEOMCP_TRANSIT_TTC_BURST=1

# BOG needs no key. false turns its offers off.
GEOMCP_OFFERS_BOG_ENABLED=true
GEOMCP_OFFERS_BOG_BASE_URL=https://bankofgeorgia.ge/api/bog-b/offers-hub
GEOMCP_OFFERS_BOG_TIMEOUT=10s
GEOMCP_OFFERS_BOG_RATE=1
GEOMCP_OFFERS_BOG_BURST=1

# TBC needs no key. false turns its offers off.
GEOMCP_OFFERS_TBC_ENABLED=true
GEOMCP_OFFERS_TBC_BASE_URL=https://apigw.tbcbank.ge/api/v1/marketing
GEOMCP_OFFERS_TBC_TIMEOUT=10s
GEOMCP_OFFERS_TBC_RATE=5
GEOMCP_OFFERS_TBC_BURST=5

# Liberty needs no key. false turns its Studio offers off.
GEOMCP_OFFERS_LIBERTY_ENABLED=true
GEOMCP_OFFERS_LIBERTY_BASE_URL=https://studioliberty.ge
GEOMCP_OFFERS_LIBERTY_TIMEOUT=10s
GEOMCP_OFFERS_LIBERTY_RATE=5
GEOMCP_OFFERS_LIBERTY_BURST=5
